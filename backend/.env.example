NODE_ENV=development
PORT=5100
MONGODB_URI=mongodb://127.0.0.1:27017/egsa_instructor
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Service-to-service key used ONLY by the future Student Project integration endpoints
INTEGRATION_API_KEY=change-me-integration
# Optional SMTP (password reset emails). If empty, reset links are logged in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@egsa.example
# Development seed password (never used in production)
SEED_INSTRUCTOR_PASSWORD="Instructor#Dev123"
